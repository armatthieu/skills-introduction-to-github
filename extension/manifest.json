{
  "manifest_version": 3,
  "name": "Meeting Time Finder for Google Calendar",
  "version": "0.1.0",
  "description": "Find the best meeting time across time zones and jump straight into a prefilled Google Calendar event.",
  "permissions": ["storage"],
  "host_permissions": ["https://calendar.google.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Find the best meeting time",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["lib/timezones.js", "lib/engine.js", "lib/storage.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
